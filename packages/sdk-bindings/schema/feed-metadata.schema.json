{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feed-metadata.schema.json",
  "title": "FeedMetadata",
  "description": "Canonical metadata describing a published price feed.",
  "x-schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["asset", "decimals", "sources", "heartbeatSeconds", "status"],
  "properties": {
    "asset": { "type": "string", "description": "Asset pair identifier, e.g. XLM/USD." },
    "decimals": { "type": "integer", "minimum": 0, "maximum": 18, "description": "Decimal places of the integer price." },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["chainlink", "redstone", "band", "reflector"] },
      "description": "Oracle providers contributing to the median."
    },
    "heartbeatSeconds": { "type": "integer", "minimum": 1, "description": "Maximum expected seconds between updates." },
    "deviationThresholdBps": { "type": "integer", "minimum": 0, "description": "Deviation in basis points that triggers an update." },
    "status": { "enum": ["active", "paused", "deprecated"], "description": "Lifecycle state of the feed." },
    "description": { "type": "string", "description": "Human readable description." }
  }
}
