{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feed-metadata.v2.schema.json",
  "title": "FeedMetadataV2",
  "description": "Versioned descriptor for a published price feed. Schema major version changes require an explicit reader upgrade; additive optional fields are forward-compatible within a major version.",
  "x-schemaVersion": 2,
  "x-compatibility": {
    "major": 2,
    "minor": 0,
    "readerPolicy": "A reader MUST reject a document whose schemaVersion major differs from the major it implements. Within the same major, readers MUST ignore unknown optional fields and MUST NOT fail because a document declares a higher minor version. Removing or renaming a field, changing a field type, or tightening a constraint requires a new major version."
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "feedId",
    "network",
    "base",
    "quote",
    "precision",
    "eligibleSources",
    "freshness",
    "ownership",
    "lifecycle"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "Major schema version of this document."
    },
    "schemaRevision": {
      "type": "integer",
      "minimum": 0,
      "description": "Additive revision within the major version; absent means 0."
    },
    "feedId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable canonical feed identifier, e.g. btc-usd."
    },
    "network": {
      "type": "string",
      "enum": [
        "stellar:pubnet",
        "stellar:testnet",
        "stellar:futurenet"
      ],
      "description": "Stellar network the feed is authoritative for."
    },
    "base": {
      "$ref": "#/$defs/unit",
      "description": "Base asset being priced."
    },
    "quote": {
      "$ref": "#/$defs/unit",
      "description": "Quote asset the price is expressed in."
    },
    "precision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18,
      "description": "Number of decimal places in the published integer price."
    },
    "eligibleSources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "weightBps",
          "required"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "chainlink",
              "redstone",
              "band",
              "reflector"
            ]
          },
          "weightBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "required": {
            "type": "boolean"
          }
        }
      },
      "description": "Sources allowed to contribute to the median, with their quorum weight."
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heartbeatSeconds",
        "maxStalenessSeconds"
      ],
      "properties": {
        "heartbeatSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxStalenessSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "deviationThresholdBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "description": "Freshness profile used by publishers and readers."
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team",
        "owner",
        "oncall"
      ],
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$",
          "description": "Accountable owner contact."
        },
        "oncall": {
          "type": "string",
          "minLength": 1,
          "description": "Escalation rotation or channel."
        }
      },
      "description": "Accountable team and escalation path for the feed."
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "since"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "proposed",
            "canary",
            "active",
            "paused",
            "deprecated",
            "retired"
          ]
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "successorFeedId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "reason": {
          "type": "string"
        }
      },
      "description": "Current lifecycle state; deprecated and retired feeds name their successor."
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "decimals"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Issuer account for non-native Stellar assets; null for native XLM or fiat units."
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      }
    }
  }
}
