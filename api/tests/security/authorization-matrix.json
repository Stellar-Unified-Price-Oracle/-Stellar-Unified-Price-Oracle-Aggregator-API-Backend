{
  "$schema": "./authorization-matrix.schema.json",
  "version": "1.0.0",
  "description": "Versioned authorization regression corpus. Each case asserts the expected allow/deny decision for a (role, scope, lifecycle state, API version) combination against a specific route or resolver. This file is executed by api/tests/security/authorization-matrix.test.ts in CI. Bump `version` whenever cases are added, removed, or their expectations change; the test suite pins the version and fails on unversioned drift.",
  "owner": "security-engineering@example.com",
  "lastReviewed": "2024-01-01",
  "schema": {
    "version": "Semantic version of this corpus (major = breaking expectation changes, minor = new cases, patch = metadata only).",
    "defaults": {
      "apiVersion": "Default API version applied to cases that omit `apiVersion`.",
      "lifecycleState": "Default lifecycle state applied to cases that omit `lifecycleState`.",
      "scope": "Default scope applied to cases that omit `scope`."
    },
    "roles": "Enumerated actor roles understood by the authorization layer.",
    "scopes": "Enumerated OAuth/token scopes understood by the authorization layer.",
    "lifecycleStates": "Enumerated resource lifecycle states used to gate access.",
    "apiVersions": "Enumerated supported API versions.",
    "cases[]": {
      "id": "Stable unique identifier for the case (used in test output and triage).",
      "description": "Human-readable intent of the case.",
      "target": "Route path or GraphQL resolver name under test.",
      "targetType": "One of: route | resolver.",
      "method": "HTTP method for route targets (omitted for resolvers).",
      "role": "Actor role from `roles`.",
      "scope": "Required scope from `scopes`, or null when no scope is required.",
      "lifecycleState": "Resource lifecycle state from `lifecycleStates`.",
      "apiVersion": "API version from `apiVersions`.",
      "expected": "One of: allow | deny.",
      "expectedStatus": "Expected HTTP status code when denied (401/403/404) or allowed (2xx).",
      "notes": "Optional rationale or ticket reference."
    }
  },
  "defaults": {
    "apiVersion": "v1",
    "lifecycleState": "active",
    "scope": null
  },
  "roles": [
    "anonymous",
    "authenticated",
    "member",
    "admin",
    "service"
  ],
  "scopes": [
    "read",
    "write",
    "admin"
  ],
  "lifecycleStates": [
    "draft",
    "active",
    "suspended",
    "archived",
    "deleted"
  ],
  "apiVersions": [
    "v1",
    "v2"
  ],
  "cases": [
    {
      "id": "route.health.anonymous.v1",
      "description": "Health endpoint is publicly readable.",
      "target": "/health",
      "targetType": "route",
      "method": "GET",
      "role": "anonymous",
      "scope": null,
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "route.auth.login.anonymous.v1",
      "description": "Login endpoint is reachable without authentication.",
      "target": "/auth/login",
      "targetType": "route",
      "method": "POST",
      "role": "anonymous",
      "scope": null,
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "route.users.me.anonymous.v1",
      "description": "Anonymous callers cannot read their own profile.",
      "target": "/users/me",
      "targetType": "route",
      "method": "GET",
      "role": "anonymous",
      "scope": null,
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 401
    },
    {
      "id": "route.users.me.authenticated.read.v1",
      "description": "Authenticated caller with read scope can read their profile.",
      "target": "/users/me",
      "targetType": "route",
      "method": "GET",
      "role": "authenticated",
      "scope": "read",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "route.users.me.authenticated.no-scope.v1",
      "description": "Authenticated caller without read scope is denied.",
      "target": "/users/me",
      "targetType": "route",
      "method": "GET",
      "role": "authenticated",
      "scope": null,
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 403
    },
    {
      "id": "route.users.update.member.write.active.v1",
      "description": "Member with write scope can update an active user.",
      "target": "/users/:id",
      "targetType": "route",
      "method": "PATCH",
      "role": "member",
      "scope": "write",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "route.users.update.member.write.suspended.v1",
      "description": "Member cannot update a suspended user.",
      "target": "/users/:id",
      "targetType": "route",
      "method": "PATCH",
      "role": "member",
      "scope": "write",
      "lifecycleState": "suspended",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 403
    },
    {
      "id": "route.users.update.member.read.archived.v1",
      "description": "Read scope is insufficient to update an archived user.",
      "target": "/users/:id",
      "targetType": "route",
      "method": "PATCH",
      "role": "member",
      "scope": "read",
      "lifecycleState": "archived",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 403
    },
    {
      "id": "route.users.delete.member.write.active.v1",
      "description": "Members cannot delete users even with write scope.",
      "target": "/users/:id",
      "targetType": "route",
      "method": "DELETE",
      "role": "member",
      "scope": "write",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 403
    },
    {
      "id": "route.users.delete.admin.admin.active.v1",
      "description": "Admin with admin scope can delete an active user.",
      "target": "/users/:id",
      "targetType": "route",
      "method": "DELETE",
      "role": "admin",
      "scope": "admin",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 204
    },
    {
      "id": "route.users.delete.admin.admin.deleted.v1",
      "description": "Deleting an already-deleted user is denied (idempotency handled at 404).",
      "target": "/users/:id",
      "targetType": "route",
      "method": "DELETE",
      "role": "admin",
      "scope": "admin",
      "lifecycleState": "deleted",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 404
    },
    {
      "id": "route.users.read.service.read.active.v1",
      "description": "Service actor with read scope can read active users.",
      "target": "/users/:id",
      "targetType": "route",
      "method": "GET",
      "role": "service",
      "scope": "read",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "route.users.read.service.read.draft.v1",
      "description": "Service actor cannot read draft users.",
      "target": "/users/:id",
      "targetType": "route",
      "method": "GET",
      "role": "service",
      "scope": "read",
      "lifecycleState": "draft",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 403
    },
    {
      "id": "route.admin.settings.admin.admin.active.v1",
      "description": "Admin with admin scope can read admin settings.",
      "target": "/admin/settings",
      "targetType": "route",
      "method": "GET",
      "role": "admin",
      "scope": "admin",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "route.admin.settings.member.admin.active.v1",
      "description": "Member role cannot access admin settings even with admin scope.",
      "target": "/admin/settings",
      "targetType": "route",
      "method": "GET",
      "role": "member",
      "scope": "admin",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 403
    },
    {
      "id": "route.users.me.authenticated.read.v2",
      "description": "v2 keeps read access to own profile for authenticated callers.",
      "target": "/users/me",
      "targetType": "route",
      "method": "GET",
      "role": "authenticated",
      "scope": "read",
      "lifecycleState": "active",
      "apiVersion": "v2",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "route.users.me.anonymous.v2",
      "description": "v2 still denies anonymous access to own profile.",
      "target": "/users/me",
      "targetType": "route",
      "method": "GET",
      "role": "anonymous",
      "scope": null,
      "lifecycleState": "active",
      "apiVersion": "v2",
      "expected": "deny",
      "expectedStatus": 401
    },
    {
      "id": "resolver.Query.me.anonymous.v1",
      "description": "GraphQL Query.me denies anonymous callers.",
      "target": "Query.me",
      "targetType": "resolver",
      "role": "anonymous",
      "scope": null,
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 401
    },
    {
      "id": "resolver.Query.me.authenticated.read.v1",
      "description": "GraphQL Query.me allows authenticated callers with read scope.",
      "target": "Query.me",
      "targetType": "resolver",
      "role": "authenticated",
      "scope": "read",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "resolver.Query.user.member.read.active.v1",
      "description": "GraphQL Query.user allows members to read active users.",
      "target": "Query.user",
      "targetType": "resolver",
      "role": "member",
      "scope": "read",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "resolver.Query.user.member.read.deleted.v1",
      "description": "GraphQL Query.user denies reads of deleted users.",
      "target": "Query.user",
      "targetType": "resolver",
      "role": "member",
      "scope": "read",
      "lifecycleState": "deleted",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 404
    },
    {
      "id": "resolver.Mutation.updateUser.member.write.active.v1",
      "description": "GraphQL Mutation.updateUser allows members with write scope on active users.",
      "target": "Mutation.updateUser",
      "targetType": "resolver",
      "role": "member",
      "scope": "write",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "resolver.Mutation.updateUser.member.read.active.v1",
      "description": "GraphQL Mutation.updateUser denies members lacking write scope.",
      "target": "Mutation.updateUser",
      "targetType": "resolver",
      "role": "member",
      "scope": "read",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 403
    },
    {
      "id": "resolver.Mutation.deleteUser.admin.admin.active.v1",
      "description": "GraphQL Mutation.deleteUser allows admins with admin scope.",
      "target": "Mutation.deleteUser",
      "targetType": "resolver",
      "role": "admin",
      "scope": "admin",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "allow",
      "expectedStatus": 200
    },
    {
      "id": "resolver.Mutation.deleteUser.member.admin.active.v1",
      "description": "GraphQL Mutation.deleteUser denies members even with admin scope.",
      "target": "Mutation.deleteUser",
      "targetType": "resolver",
      "role": "member",
      "scope": "admin",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 403
    },
    {
      "id": "resolver.Mutation.deleteUser.service.admin.active.v1",
      "description": "GraphQL Mutation.deleteUser denies service actors (human-only operation).",
      "target": "Mutation.deleteUser",
      "targetType": "resolver",
      "role": "service",
      "scope": "admin",
      "lifecycleState": "active",
      "apiVersion": "v1",
      "expected": "deny",
      "expectedStatus": 403
    },
    {
      "id": "resolver.Query.me.authenticated.read.v2",
      "description": "GraphQL Query.me allows authenticated callers with read scope on v2.",
      "target": "Query.me",
      "targetType": "resolver",
      "role": "authenticated",
      "scope": "read",
      "lifecycleState": "active",
      "apiVersion": "v2",
      "expected": "allow",
      "expectedStatus": 200
    }
  ]
}