# Stellar Price Oracle â€” Environment Configuration
# Copy to .env and fill in your values
#
# Aggregator variables are documented as:
#   # <KEY> | <type> | default=<value> | <effect>
# and are validated at startup by
# services/aggregator/src/infrastructure/config-schema.ts. Every invalid
# variable is reported and the process exits before it serves traffic.
# Validate a config without starting the service:
#   npm run check-config        (from services/aggregator)
#   node services/aggregator/dist/index.js --check-config

# === Aggregator Service ===
# PORT is the offset base only: the WS server binds PORT + 1 and the
# health+/metrics server binds PORT + 2. Nothing listens on PORT itself.
PORT=4000
# POLLING_INTERVAL_MS | int | default=30000 | Milliseconds between price polling rounds. Range 100..3600000; values that are not integers are rejected instead of firing setInterval(NaN) in a tight loop.
POLLING_INTERVAL_MS=30000
# STALENESS_THRESHOLD_MS | int | default=120000 | Age after which an aggregated price is reported stale. Range 1..86400000; must match the API's value.
STALENESS_THRESHOLD_MS=120000
# WATCHED_ASSETS | csv | default=XLM,USDC,BTC,ETH,USDT | Comma-separated asset symbols to poll and publish. Entries are trimmed, upper-cased and de-duplicated; empty entries are rejected and the list must not be empty. Max 50 symbols, each A-Z 0-9 : _ - (max 32 chars).
WATCHED_ASSETS=XLM,USDC,BTC,ETH,USDT
# LOG_LEVEL | string | default=info | Winston log level: error, warn, info, http, verbose, debug, silly.
LOG_LEVEL=info

# === Graceful Shutdown (Issue #579) ===
# SIGTERM/SIGINT drain budget: max wait for the in-flight poll cycle and the
# contract-submission retry queue before giving up.
SHUTDOWN_DRAIN_DEADLINE_MS=25000
# Hard exit timer (non-zero exit code) armed at the first signal. Must be
# larger than the drain deadline and smaller than the k8s
# terminationGracePeriodSeconds (60s) — see docs/PRODUCTION_DEPLOYMENT.md §10.
SHUTDOWN_FORCE_EXIT_MS=35000

# === Soroban Contract ===
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# CONTRACT_ID | string | default= | Contract to publish to. Empty runs the aggregator in dry-run mode with no on-chain writes.
CONTRACT_ID=
# NETWORK_PASSPHRASE | string | default="Test SDF Network ; September 2015" | Stellar network passphrase used to sign transactions.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# ADMIN_SECRET_KEY | string | default= | Contract admin secret. Supports enc: payloads when ENCRYPTION_KEY is set (issue #41).
ADMIN_SECRET_KEY=

# === Canary Releases (Issue #105) ===
# CANARY_FAILURE_THRESHOLD | int | default=3 | Consecutive canary submission failures before the publisher triggers an on-chain rollback. Range 1..100.
CANARY_FAILURE_THRESHOLD=3
# CANARY_AUTO_ROLLBACK | bool | default=true | Set to false to disable the on-chain auto-rollback write; failures are then only logged and metric-alerted.
CANARY_AUTO_ROLLBACK=true

# === Oracle Source Endpoints ===
# CHAINLINK_BASE_URL | url | default=https://min-api.cryptocompare.com/data | Chainlink-compatible price endpoint. Must be an absolute http(s) URL; its host becomes part of the SSRF allowlist.
CHAINLINK_BASE_URL=https://min-api.cryptocompare.com/data
# CHAINLINK_API_KEY | string | default= | Optional API key for the Chainlink-compatible endpoint. Supports enc: payloads.
CHAINLINK_API_KEY=

# === Oracle API Daily Budgets (Issue #583) ===
# Effective budgets come from config/cost-model.json (runtimeOracleCallModel.
# dailyBudgetCalls); these env vars override per source without a redeploy.
# At 80% utilization a warning fires; at 100% the source stops being polled
# until the UTC rollover (a deliberate, alerted degradation).
ORACLE_BUDGET_DAILY_CALLS_CHAINLINK=10000
ORACLE_BUDGET_DAILY_CALLS_REDSTONE=10000
ORACLE_BUDGET_DAILY_CALLS_BAND=10000
ORACLE_BUDGET_DAILY_CALLS_REFLECTOR=10000

REDSTONE_BASE_URL=https://api.redstone.finance
# BAND_BASE_URL | url | default=https://laozi1.bandchain.org/api | Band Protocol price endpoint; its host becomes part of the SSRF allowlist.
BAND_BASE_URL=https://laozi1.bandchain.org/api
# REFLECTOR_BASE_URL | url | default=https://api.reflector.xyz | Reflector price endpoint; its host becomes part of the SSRF allowlist.
REFLECTOR_BASE_URL=https://api.reflector.xyz

# === REST API ===
API_PORT=3000
WS_PORT=3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Comma-separated IPs/CIDRs of trusted edge proxies. X-Forwarded-For and
# x-geo-region are only honoured when the TCP peer matches; empty = direct.
TRUSTED_PROXY_IPS=
CACHE_TTL_MS=15000

# === CORS allowlist (Issue #597) ===
# Comma-separated browser origins allowed to call the API with credentials.
# Empty = fail closed: no cross-origin request is granted access.
# Accepted patterns: exact http(s) origins (https://app.example.com),
# subdomain wildcards (*.example.com covers the apex and any depth of
# subdomain), or the literal null (sandboxed iframes). The bare '*' is
# rejected because responses are sent with credentials:true.
CORS_ALLOWED_ORIGINS=
# Development-only opt-in: allow every origin WITHOUT credentials (the
# request origin is reflected and credentials are disabled). Never set in
# staging or production.
CORS_ALLOW_ANY=false
# Local cache of the allowlist. The shared store (Vault, secret/data/cors/
# origins) is the source of truth when Vault is available; this file only
# mirrors it so a restart keeps origins until the first refresh.
CORS_PERSIST_PATH=/tmp/cors-origins.json

# === Redis Cache (Optional) ===
# Leave empty to use LRU cache fallback
REDIS_URL=
PRICE_CACHE_TTL_MS=15000
HISTORY_CACHE_TTL_MS=60000
SOURCES_CACHE_TTL_MS=300000
HEALTH_CACHE_TTL_MS=30000

# === PostgreSQL / TimescaleDB Database (Optional) ===
# Leave empty to use file-based storage
# DATABASE_URL | string | default= | PostgreSQL connection string. Empty falls back to file-based history storage. Supports enc: payloads.
DATABASE_URL=postgresql://user:password@localhost:5432/stellar_oracle
# Issue #42 â€” TimescaleDB hypertable for historical price data.
# Set to "false" to keep a plain Postgres table (auto-falls back if the
# timescaledb extension is not installed).
USE_TIMESCALEDB=true
# TIMESCALE_CHUNK_INTERVAL_SECONDS | int | default=604800 | Hypertable chunk interval in seconds for the integer timestamp dimension (7 days). Range 60..2592000.
TIMESCALE_CHUNK_INTERVAL_SECONDS=604800
# HISTORY_RETENTION_DAYS | int | default=0 | Automatic database retention in days; 0 keeps history forever. Range 0..3650.
HISTORY_RETENTION_DAYS=0

# === Connection Pooling, Retry & Circuit Breaker (Issue #44) ===
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Exponential-backoff retry for transient failures.
DATABASE_RETRY_MAX=3
DATABASE_RETRY_BASE_DELAY_MS=100
DATABASE_RETRY_MAX_DELAY_MS=2000
# Circuit breaker prevents thundering herd against an unhealthy DB.
DATABASE_CIRCUIT_BREAKER_ENABLED=true
DATABASE_CB_FAILURE_THRESHOLD=5
DATABASE_CB_SUCCESS_THRESHOLD=2
DATABASE_CB_OPEN_MS=10000

# === Read Replicas (Issue #45) ===
# Comma-separated replica connection strings. Reads are distributed across
# healthy replicas; writes always go to the primary DATABASE_URL.
DATABASE_REPLICA_URLS=
# Max tolerated replication lag (ms) before a read falls back to the primary
# (0 disables the lag check).
DATABASE_REPLICA_MAX_LAG_MS=0
# Replica health-check interval (ms).
DATABASE_REPLICA_HEALTHCHECK_MS=10000

# === Aggregator File History (Issue #214) ===
# HISTORY_MAX_ENTRIES | int | default=10000 | Maximum rows kept per asset in the file-based history store; 0 disables the cap. Range 0..10000000.
HISTORY_MAX_ENTRIES=10000
# HISTORY_RETENTION_SECONDS | int | default=604800 | Age in seconds after which file-based history rows are dropped on append; 0 disables. Range 0..315360000.
HISTORY_RETENTION_SECONDS=604800

# === Aggregator File Archival (Issue #43) ===
# FILE_ARCHIVAL_ENABLED | bool | default=false | Enable the aggregator's scheduled archival loop that moves old history files to cold storage.
FILE_ARCHIVAL_ENABLED=false
# FILE_ARCHIVE_AFTER_DAYS | int | default=90 | Move history files older than this many days to cold storage. Range 1..3650.
FILE_ARCHIVE_AFTER_DAYS=90
# FILE_RETENTION_DAYS | int | default=0 | Days to keep cold-storage archives before deleting them; 0 keeps forever. Range 0..3650.
FILE_RETENTION_DAYS=0
# FILE_COLD_STORAGE_DIR | string | default=./data/archive | Directory that receives cold-storage archive files.
FILE_COLD_STORAGE_DIR=./data/archive
# FILE_ARCHIVAL_INTERVAL_MS | int | default=86400000 | Interval between scheduled archival passes (24h). Range 1000..604800000.
FILE_ARCHIVAL_INTERVAL_MS=86400000

# === API Service Data Archival (Issue #43) ===
# Enable the API's scheduled archival loop.
DATABASE_ARCHIVAL_ENABLED=false
# Move records older than this many days to cold storage.
HISTORY_ARCHIVE_AFTER_DAYS=90
# Directory for gzip NDJSON cold-storage archive files.
COLD_STORAGE_DIR=./data/archive
# Rows per archive batch.
ARCHIVAL_BATCH_SIZE=5000
# Interval between scheduled archival passes (ms, default 24h).
ARCHIVAL_INTERVAL_MS=86400000

# === SSRF Protection â€” Outbound Oracle Requests (Issue #39) ===
# Outbound requests are restricted to the hosts of the configured source URLs
# above. Add extra allowed hosts here (comma-separated) if needed.
ORACLE_ALLOWED_HOSTS=
# SSRF_PROTECTION_ENABLED | bool | default=true | Set to false to disable outbound SSRF validation (NOT recommended).
SSRF_PROTECTION_ENABLED=true
# SSRF_ALLOW_PRIVATE_IPS | bool | default=false | Allow outbound requests to private/internal IPs (NOT recommended; testing only).
SSRF_ALLOW_PRIVATE_IPS=false
# OUTBOUND_REQUEST_TIMEOUT_MS | int | default=10000 | Timeout for outbound oracle-source HTTP requests. Range 100..300000.
OUTBOUND_REQUEST_TIMEOUT_MS=10000

# === WebSocket Security (Issue #40) ===
# WS_ALLOWED_ORIGINS | csv | default= | Comma-separated browser origins allowed to upgrade to the aggregator WebSocket. Empty allows any origin that sends an Origin header; * allows all.
WS_ALLOWED_ORIGINS=
# WS_REQUIRE_ORIGIN | bool | default=true | Require an Origin header on upgrade (rejects unknown non-browser clients).
WS_REQUIRE_ORIGIN=true
# WS_RATE_LIMIT_MAX | int | default=20 | Per-IP connection rate limit for upgrade attempts within the window. Range 1..10000.
WS_RATE_LIMIT_MAX=20
# WS_RATE_LIMIT_WINDOW_MS | int | default=60000 | Rate-limit window for upgrade attempts in milliseconds. Range 1000..3600000.
WS_RATE_LIMIT_WINDOW_MS=60000
# Issue #586: X-Forwarded-For/Forwarded headers are trusted only when the
# direct socket peer is in one of these CIDRs (comma-separated, IPv4 or
# IPv6). Empty = never trust forwarded headers.
WS_TRUSTED_PROXY_CIDRS=
# Issue #586: with an empty WS_ALLOWED_ORIGINS, production deployments reject
# browser connections from every origin (fail closed). Set to "true" to opt
# in to accepting any origin — browser-origin enforcement is NOT
# authentication and must not be relied on for access control.
WS_ALLOW_ALL_ORIGINS=
# CSRF protection for the API WebSocket. When set, clients must fetch a token
# from GET /api/v1/ws-token and pass it as ?token=<token> on the WS URL.
WS_CSRF_SECRET=
WS_CSRF_TTL_MS=300000

# === WebSocket replay bounding (Issue #606) ===
# Messages retained per asset for replay.
WS_BUFFER_SIZE=200
# Maximum assets holding a buffer, and total retained bytes across all assets.
WS_BUFFER_MAX_ASSETS=64
WS_BUFFER_MAX_BYTES=8388608
# Per-request replay bounds: a replay delivers at most these many messages/bytes.
WS_REPLAY_MAX_MESSAGES=200
WS_REPLAY_MAX_BYTES=262144
# Per-connection replay request rate limit.
WS_REPLAY_RATE_LIMIT=10
WS_REPLAY_RATE_WINDOW_MS=60000

# === GraphQL preview surface (Issue #607) ===
# Disabled by default. When disabled the endpoint answers 403 GRAPHQL_DISABLED.
GRAPHQL_ENABLED=false
# Introspection (__schema/__type) is off unless explicitly enabled.
GRAPHQL_INTROSPECTION=false
# Depth and complexity budgets. Complexity: 1 per field plus its `limit` argument.
GRAPHQL_MAX_DEPTH=5
GRAPHQL_MAX_COMPLEXITY=100
# Same clamp REST uses for paginated list arguments.
GRAPHQL_MAX_LIMIT=25
# Per-query execution budget; exceeding it returns 504 QUERY_TIMEOUT.
GRAPHQL_TIMEOUT_MS=5000
GRAPHQL_MAX_QUERY_LENGTH=10000
# Tiers allowed to use GraphQL at all.
GRAPHQL_ALLOWED_TIERS=pro,enterprise

# HMAC signing for WebSocket connections (Issue #35).
# When set, clients must pass ?ts=<epoch_ms>&nonce=<uuid>&sig=<hmac-sha256>
# on the WS URL. Sign the string "<ts>.<nonce>." with WS_HMAC_SECRET using
# HMAC-SHA256 and hex encoding.
WS_HMAC_SECRET=

# === Encryption at Rest (Issue #41) ===
# 32-byte key as 64 hex chars (generate with: tsx scripts/encrypt-secret.ts genkey).
# When set, sensitive env values stored as `enc:...` payloads are decrypted at
# startup, including API keys, database URLs, Redis URLs, WebSocket secrets,
# audit secrets, backup keys, and alert/webhook secrets.
# ENCRYPTION_KEY | string | default= | 64 hex characters. Any other non-empty value is rejected at startup.
ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS | string | default= | During key rotation, keep the previous key here so old data still decrypts. Same format as ENCRYPTION_KEY.
ENCRYPTION_KEY_PREVIOUS=

# === Audit chain (Issue #598) ===
# Required when NODE_ENV=production; startup fails without it. Outside production
# an ephemeral per-process key is used, so no default signing key exists.
AUDIT_SECRET=
# Signing key kept during rotation so entries signed with it stay verifiable.
AUDIT_SECRET_PREVIOUS=
# Where audit entries are appended. Give each replica its own path when the
# volume is not shared. Entries are also written to stdout for the log shipper.
AUDIT_LOG_FILE=logs/audit.log
AUDIT_STDOUT=true
# Scheduled chain verification interval in ms; 0 disables it.
AUDIT_CHAIN_VERIFY_INTERVAL_MS=3600000
# throw = refuse startup when the existing chain cannot be verified
# (default preserves the broken log and starts a new chain).
AUDIT_CHAIN_ON_BREAK=
# Encrypt historical price JSON files written by the aggregator.
ENCRYPT_HISTORY=false

# === Audit Log Retention (Issue #599) ===
# Age in days before an entry leaves logs/audit.log for logs/audit-archive/.
# Retention runs on a schedule, never on the request path. 0 disables it.
AUDIT_RETENTION_DAYS=90
# Milliseconds between scheduled retention sweeps (default 1 hour).
AUDIT_RETENTION_SWEEP_MS=3600000
# Directory holding audit.log, the audit-archive/ folder and the retention lock.
AUDIT_LOG_DIR=logs
# HMAC-SHA256 key for the tamper-evident audit chain. Set in production.
AUDIT_SECRET=

# === Webhooks (Issue #601) ===
# Durable store for registrations, delivery history and dead letters.
# With REDIS_URL set every replica shares the Redis store; otherwise files are
# written under WEBHOOK_DATA_DIR (point every replica at the same volume).
WEBHOOK_DATA_DIR=data/webhooks
# How long delivery history and dead letters are kept, in days.
WEBHOOK_DELIVERY_RETENTION_DAYS=30
# Hard cap on stored delivery records, newest kept.
WEBHOOK_DELIVERY_MAX_ENTRIES=20000
# Propagation window: how long a registration change can take to be visible on
# another replica that mirrors the same store.
WEBHOOK_PROPAGATION_MS=5000
# Interval between retention sweeps of the stored delivery/dead-letter records.
WEBHOOK_PRUNE_INTERVAL_MS=60000
# Delivery retry/backoff and trigger pacing.
WEBHOOK_BASE_DELAY_MS=1000
WEBHOOK_MAX_DELAY_MS=60000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MIN_INTERVAL_MS=60000

# === Price Anomaly Alerting ===
# Generic JSON webhook for all alert events.
ALERT_WEBHOOK_URL=
# Slack incoming webhook URL.
ALERT_SLACK_WEBHOOK_URL=
# PagerDuty Events API v2 integration/routing key.
ALERT_PAGERDUTY_ROUTING_KEY=
# Opsgenie API key for degraded / warning routes.
ALERT_OPSGENIE_API_KEY=
# Transactional email API webhook (e.g. SendGrid/Mailgun inbound proxy) and comma-separated recipients.
ALERT_EMAIL_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENTS=
# Percent spread between oracle sources before a disagreement alert fires.
ALERT_SOURCE_DISAGREEMENT_PERCENT=5

# === Webhook Egress (Issue #600) ===
# Outbound requests are made to URLs supplied via POST /webhooks.
# Require https: for registered webhook URLs (default: true).
WEBHOOK_REQUIRE_HTTPS=true
# Permit webhook URLs that resolve to private/loopback/link-local addresses.
# Development only — never enable in production.
WEBHOOK_ALLOW_PRIVATE_IPS=false
# Comma-separated exact hosts a webhook URL may use. Empty = any public host.
WEBHOOK_ALLOWED_HOSTS=
# JSON map of API key prefix -> hosts that tenant may register. A tenant entry
# replaces the global list for that key and can only narrow it.
# e.g. {"ab12cd34":["hooks.example.com"]}
WEBHOOK_ALLOWED_HOSTS_BY_TENANT=

# === API Key Store (Issue #591) ===
# Where the shared API key state lives: memory (per-process) or redis.
# Defaults to redis when REDIS_URL is set, memory otherwise. Multi-replica
# deployments must use redis; memory keeps state local to the process.
API_KEY_STORE=memory
# How often each replica re-reads the shared store. This is the documented
# upper bound on how long a create/revoke takes to reach every replica.
API_KEY_STORE_REFRESH_MS=1000
# Fail closed when the store is unreachable: validation rejects every key
# until the store answers again. Set to false only for local development.
API_KEY_STORE_FAIL_CLOSED=true

# === API Service URL (used by the API to query the aggregator health endpoint) ===
# AGGREGATOR_URL | url | default=http://localhost:4002 | Aggregator health+metrics base URL; the API's consistency checker and status page hit this.
AGGREGATOR_URL=http://localhost:4002

# === Multi-Region Replication (Issue #multi-region) ===
# ACTIVE_ACTIVE_REGIONS_ENABLED | bool | default=false | Enable active-active cross-region replication via Kafka.
ACTIVE_ACTIVE_REGIONS_ENABLED=false
# REGION_ID | string | default=local | Identifier for this region replica (lowercase letters, digits, dashes).
REGION_ID=local
# REGION_PEERS | csv | default= | Comma-separated region IDs that this replica replicates with.
REGION_PEERS=
# REGION_REPLICATION_TOPIC | string | default=stellar-oracle-prices | Kafka topic used for cross-region price replication.
REGION_REPLICATION_TOPIC=stellar-oracle-prices
# REGION_DRIFT_ALERT_PERCENT | float | default=0.1 | Percent price divergence between regions that triggers a drift alert. Range 0..100.
REGION_DRIFT_ALERT_PERCENT=0.1
# REGION_QUARANTINE_ENABLED | bool | default=false | Enable automatic quarantine of a region whose prices diverge beyond REGION_DRIFT_ALERT_PERCENT.
REGION_QUARANTINE_ENABLED=false
# REGION_QUARANTINE_RECOVER_PERCENT | float | default=0.05 | Divergence threshold (<=REGION_DRIFT_ALERT_PERCENT) below which a quarantined region recovers. Range 0..100.
REGION_QUARANTINE_RECOVER_PERCENT=0.05
# REGION_MAX_REPLICATION_LAG_MS | int | default=5000 | Max tolerated replication lag in milliseconds before a stale-replica alert fires. Range 1..600000.
REGION_MAX_REPLICATION_LAG_MS=5000

# === Kafka (cross-region replication transport) ===
# KAFKA_BROKERS | csv | default= | Bootstrap broker list (host or host:port). Required when ACTIVE_ACTIVE_REGIONS_ENABLED=true.
KAFKA_BROKERS=
# KAFKA_SSL_ENABLED | bool | default=false | Enable TLS for Kafka broker connections.
KAFKA_SSL_ENABLED=false

# === Anomaly Detection ===
# ANOMALY_WINDOW_SIZE | int | default configured in source | Rolling window length (number of samples) used for Z-score anomaly detection.
ANOMALY_WINDOW_SIZE=
# ANOMALY_ZSCORE_THRESHOLD | float | default configured in source | Z-score above which a price reading is flagged as anomalous.
ANOMALY_ZSCORE_THRESHOLD=
# ANOMALY_MOVING_AVERAGE_DEVIATION | float | default configured in source | Max allowed deviation from the moving average (as a fraction) before flagging.
ANOMALY_MOVING_AVERAGE_DEVIATION=
# ANOMALY_VOLATILITY_MULTIPLIER | float | default configured in source | Multiplier applied to recent volatility when setting dynamic anomaly thresholds.
ANOMALY_VOLATILITY_MULTIPLIER=

# === SLA Breach Alerting ===
# ALERT_SLA_BREACH_MAX_PER_WINDOW | int | default=10 | Maximum SLA breaches allowed per window before an alert fires.
ALERT_SLA_BREACH_MAX_PER_WINDOW=10
# ALERT_SLA_BREACH_WINDOW_SECONDS | int | default=300 | Rolling window in seconds for counting SLA breaches. Range 1..86400.
ALERT_SLA_BREACH_WINDOW_SECONDS=300

# === Backup Service ===
# BACKUP_ENABLED | bool | default=false | Enable the API's scheduled encrypted backup service.
BACKUP_ENABLED=false
# BACKUP_DIR | string | default=./data/backups | Directory where encrypted backup snapshots are written.
BACKUP_DIR=./data/backups
# BACKUP_INTERVAL_MS | int | default=86400000 | Interval between scheduled backups in milliseconds (default 24h).
BACKUP_INTERVAL_MS=86400000

# === Source Circuit Breaker ===
# CB_FAILURE_THRESHOLD | int | default configured in source | Consecutive failures before the per-source circuit breaker opens.
CB_FAILURE_THRESHOLD=
# CB_COOLDOWN_MS | int | default configured in source | Time in milliseconds a tripped circuit breaker stays open before half-open retry.
CB_COOLDOWN_MS=
# CB_HALF_OPEN_SUCCESSES | int | default configured in source | Successful probes needed to close a half-open circuit breaker.
CB_HALF_OPEN_SUCCESSES=

# === Compression ===
# COMPRESSION_ENABLED | bool | default=true | Enable HTTP response compression in the API.
COMPRESSION_ENABLED=true
# COMPRESSION_THRESHOLD | int | default=1024 | Minimum response size in bytes before compression is applied.
COMPRESSION_THRESHOLD=1024
# COMPRESSION_LEVEL | int | default=6 | zlib compression level (1=fastest, 9=best compression). Range 1..9.
COMPRESSION_LEVEL=6

# === Data Consistency Checker ===
# CONSISTENCY_CHECK_ENABLED | bool | default=true | Enable the API's periodic consistency check between the database and the aggregator.
CONSISTENCY_CHECK_ENABLED=true
# CONSISTENCY_CHECK_INTERVAL_MS | int | default=60000 | Interval between scheduled consistency checks in milliseconds.
CONSISTENCY_CHECK_INTERVAL_MS=60000

# === Contract Gas / Fee Parameters ===
# CONTRACT_BASE_INCLUSION_FEE | int | default configured in source | Base Stellar inclusion fee in stroops for contract submissions.
CONTRACT_BASE_INCLUSION_FEE=
# CONTRACT_MAX_INCLUSION_FEE | int | default configured in source | Maximum inclusion fee in stroops the publisher will bid during surge pricing.
CONTRACT_MAX_INCLUSION_FEE=
# CONTRACT_MAX_RESOURCE_FEE | int | default configured in source | Maximum resource fee in stroops per submission.
CONTRACT_MAX_RESOURCE_FEE=
# CONTRACT_FEE_SURGE_MULTIPLIER | float | default configured in source | Multiplier applied to the base fee during network congestion.
CONTRACT_FEE_SURGE_MULTIPLIER=
# CONTRACT_GAS_ALERT_THRESHOLD | int | default configured in source | Accumulated gas spend in stroops that triggers an alert.
CONTRACT_GAS_ALERT_THRESHOLD=
# TX_POLL_RETRIES | int | default configured in source | Number of times to poll for a transaction result before giving up.
TX_POLL_RETRIES=
# TX_POLL_INTERVAL_MS | int | default configured in source | Milliseconds between transaction-result polling attempts.
TX_POLL_INTERVAL_MS=

# === Database Health Monitor ===
# DB_HEALTH_CHECK_INTERVAL_MS | int | default=15000 | Interval between DB health probe cycles in milliseconds.
DB_HEALTH_CHECK_INTERVAL_MS=15000
# DB_HEALTH_EXHAUSTION_THRESHOLD | float | default=0.8 | Pool utilisation fraction (0..1) above which a pool-exhaustion alert fires.
DB_HEALTH_EXHAUSTION_THRESHOLD=0.8
# DB_HEALTH_SLOW_QUERY_MS | int | default=5000 | Query duration in milliseconds above which a slow-query alert fires.
DB_HEALTH_SLOW_QUERY_MS=5000
# DB_HEALTH_REPLICA_LAG_ALERT_MS | int | default=30000 | Replica lag in milliseconds above which a replication-lag alert fires.
DB_HEALTH_REPLICA_LAG_ALERT_MS=30000

# === Disaster Recovery Targets ===
# DR_RTO_TARGET_SECONDS | int | default=3600 | Recovery-time objective in seconds; used by the DR status endpoint and health checks.
DR_RTO_TARGET_SECONDS=3600
# DR_RPO_TARGET_SECONDS | int | default=300 | Recovery-point objective in seconds.
DR_RPO_TARGET_SECONDS=300

# === DSAR / Compliance ===
# DSAR_STORE_PATH | string | default configured in source | File path for the durable DSAR request store (used when Vault is unavailable).
DSAR_STORE_PATH=
# COMPLIANCE_LOG_DIR | string | default configured in source | Directory for compliance audit log output files.
COMPLIANCE_LOG_DIR=

# === Feature Flags ===
# FEATURE_FLAGS_JSON | json | default={} | Inline JSON object of feature flag overrides (e.g. {"graphql":true}). Takes precedence over defaults.
FEATURE_FLAGS_JSON=

# === Programmable Feeds ===
# FEED_FREE_TIER_COUNT | int | default configured in source | Number of feeds available to free-tier keys before rate enforcement.
FEED_FREE_TIER_COUNT=
# FEED_GAS_LIMIT | int | default configured in source | Maximum Wasm gas budget per programmable-feed execution.
FEED_GAS_LIMIT=
# FEED_DEVIATION_ALERT_BPS | int | default configured in source | Basis-point price deviation that triggers a feed alert.
FEED_DEVIATION_ALERT_BPS=

# === GeoIP ===
# GEOIP_DATABASE_PATH | string | default= | Path to a MaxMind GeoLite2-City.mmdb file for geo-region header enrichment. Empty disables geo lookup.
GEOIP_DATABASE_PATH=

# === Tracing / OpenTelemetry ===
# TRACING_ENABLED | bool | default=false | Enable OpenTelemetry distributed tracing export.
TRACING_ENABLED=false
# OTLP_TRACE_ENDPOINT | url | default= | OTLP HTTP endpoint for trace export (takes precedence over JAEGER_ENDPOINT).
OTLP_TRACE_ENDPOINT=
# JAEGER_ENDPOINT | url | default= | Legacy Jaeger HTTP collector endpoint. Prefer OTLP_TRACE_ENDPOINT for new deployments.
JAEGER_ENDPOINT=
# TRACING_SAMPLING_RATE | float | default=1.0 | Fraction of traces to sample (0.0–1.0). Use <1.0 in high-volume production.
TRACING_SAMPLING_RATE=1.0
# TRACING_SERVICE_NAME | string | default=stellar-oracle-api | Service name reported in trace spans.
TRACING_SERVICE_NAME=stellar-oracle-api

# === Pipeline Metadata ===
# PIPELINE_VERSION | string | default= | Semantic version string stamped onto aggregated price records for lineage tracking.
PIPELINE_VERSION=

# === Post-Quantum TLS / Crypto ===
# PQ_TLS_ENABLED | bool | default=false | Enable post-quantum TLS hybrid mode (experimental).
PQ_TLS_ENABLED=false
# PQ_TLS_PROVIDER | string | default configured in source | TLS provider name for post-quantum handshake (e.g. oqs-provider).
PQ_TLS_PROVIDER=
# PQ_TLS_GROUP | string | default configured in source | Named key-exchange group (e.g. X25519Kyber768Draft00).
PQ_TLS_GROUP=
# PQ_CRYPTO_ENABLED | bool | default=false | Enable post-quantum cryptographic primitives for application-layer signing.
PQ_CRYPTO_ENABLED=false
# PQ_DEFAULT_SCHEME | string | default configured in source | Default post-quantum signature scheme name.
PQ_DEFAULT_SCHEME=
# PQ_THREAT_FEED_URL | url | default= | URL of the threat-intelligence feed used to assess harvest-now-decrypt-later risk.
PQ_THREAT_FEED_URL=
# PQ_THREAT_ALERT_THRESHOLD | int | default configured in source | Threat score above which a PQ-readiness alert fires.
PQ_THREAT_ALERT_THRESHOLD=

# === Public / Portal Base URL ===
# PUBLIC_BASE_URL | url | default= | Canonical public base URL for the API (used in hypermedia links and CORS validation).
PUBLIC_BASE_URL=
# PUBLIC_BASE_ALLOWED_HOSTS | csv | default= | Additional allowed host names for public-URL validation (comma-separated).
PUBLIC_BASE_ALLOWED_HOSTS=

# === Redis Rate-Limit (distributed, multi-instance) ===
# RATE_LIMIT_REDIS_URLS | csv | default= | Comma-separated Redis URLs used for distributed rate limiting across replicas. Falls back to in-process limiter when empty.
RATE_LIMIT_REDIS_URLS=

# === Sandbox Mode ===
# SANDBOX_ENABLED | bool | default=false | Enable the sandbox API surface (isolated test environment with seeded prices).
SANDBOX_ENABLED=false

# === Schema Dark-Read Period ===
# SCHEMA_DARK_READ_HOURS | int | default configured in source | Hours after a schema migration during which dual-read (old+new schema) is active.
SCHEMA_DARK_READ_HOURS=

# === Webhook Advanced Settings ===
# WEBHOOK_CIRCUIT_THRESHOLD | int | default=3 | Consecutive delivery failures before the per-destination circuit breaker opens.
WEBHOOK_CIRCUIT_THRESHOLD=3
# WEBHOOK_CIRCUIT_COOLDOWN_MS | int | default=60000 | Time in milliseconds a tripped webhook circuit breaker stays open.
WEBHOOK_CIRCUIT_COOLDOWN_MS=60000
# WEBHOOK_MAX_CONCURRENT | int | default=5 | Maximum concurrent outbound webhook deliveries.
WEBHOOK_MAX_CONCURRENT=5
# WEBHOOK_MAX_PENDING | int | default=100 | Maximum pending delivery records per destination URL.
WEBHOOK_MAX_PENDING=100

# === WebSocket Advanced Settings ===
# WS_MAX_SUBSCRIPTIONS | int | default=100 | Maximum number of asset subscriptions per WebSocket connection. Range 1..10000.
WS_MAX_SUBSCRIPTIONS=100
# WS_MAX_CONCURRENT_CONNECTIONS_PER_IP | int | default=10 | Maximum concurrent WebSocket connections from a single IP address.
WS_MAX_CONCURRENT_CONNECTIONS_PER_IP=10
# WS_BACKPRESSURE_DROP_BYTES | int | default=1048576 | Bytes buffered per connection before the server drops the connection under backpressure (1 MiB). Range 1024..268435456.
WS_BACKPRESSURE_DROP_BYTES=1048576
# WS_PING_INTERVAL_MS | int | default=30000 | Interval between server-initiated WebSocket pings in milliseconds. Range 1000..600000.
WS_PING_INTERVAL_MS=30000
# WS_PING_TIMEOUT_MS | int | default=10000 | Time in milliseconds to wait for a pong before closing an unresponsive connection. Range 1000..600000.
WS_PING_TIMEOUT_MS=10000
# WS_MAX_CLIENT_MESSAGE_BYTES | int | default=4096 | Maximum allowed WebSocket message size from a client in bytes. Range 256..65536.
WS_MAX_CLIENT_MESSAGE_BYTES=4096
# WS_MAX_FORWARDED_HOPS | int | default configured in source | Maximum X-Forwarded-For hops to trust when WS_TRUSTED_PROXY_CIDRS is set.
WS_MAX_FORWARDED_HOPS=
