{
  "name": "@stellar-oracle/monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/aggregator",
    "api"
  ],
  "scripts": {
    "build:types": "cd packages/types && npm run build",
    "build:vault": "cd packages/vault-client && npm run build",
    "build:ssrf": "cd packages/ssrf-guard && npm run build",
    "build:packages": "npm run build:types && npm run build:vault && npm run build:ssrf",
    "build:aggregator": "cd services/aggregator && npm run build",
    "build:api": "cd api && npm run build",
    "build:backend": "npm run build:packages && npm run build:aggregator && npm run build:api",
    "build:contract": "cd contracts/price-oracle && cargo build --release",
    "test:aggregator": "cd services/aggregator && npm test",
    "test:api": "cd api && npm test",
    "test:contract": "cd contracts/price-oracle && cargo test",
    "test:backend": "npm run test:aggregator && npm run test:api",
    "test:integration": "node scripts/integration-test.mjs",
    "check:env": "node scripts/check-env-contract.mjs",
    "check:routes": "node scripts/check-route-contract.mjs",
    "check:ports": "node scripts/check-port-consistency.mjs",
    "check:contracts": "npm run check:env && npm run check:routes && npm run check:ports",
    "typecheck:all": "cd packages/types && npx tsc --noEmit && cd ../../packages/vault-client && npx tsc --noEmit && cd ../../services/aggregator && npx tsc --noEmit && cd ../../api && npx tsc --noEmit",
    "verify:tools": "node scripts/install-verification-tools.mjs",
    "verify:contract": "node scripts/install-verification-tools.mjs && node scripts/generate-verification-report.mjs --cargo",
    "verify:formal": "node scripts/install-verification-tools.mjs && node scripts/generate-verification-report.mjs",
    "plugin:test": "node scripts/plugin-test.mjs",
    "capacity:report": "node scripts/capacity-model.mjs",
    "cost:analyze": "node scripts/analyze-infrastructure-costs.mjs",
    "cost:check": "node scripts/analyze-infrastructure-costs.mjs --check",
    "cost:reconcile": "node scripts/reconcile-cost-invoices.mjs",
    "validate:prices": "node scripts/validate-price-correctness.mjs",
    "rent:extend": "tsx scripts/extend-ttl-job.ts",
    "install:all": "npm install",
    "prepare": "(husky || true) && npm run build:packages"
  },
  "devDependencies": {
    "husky": "^9.1.0"
  },
  "overrides": {
    "toml": "^4.2.0",
    "undici": "^6.28.0"
  }
}
